{
  "name": "merchops-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "npm run dev -w @merchops/frontend",
    "dev:backend": "npm run dev -w @merchops/backend",
    "dev:all": "npm run dev -w @merchops/backend & npm run dev -w @merchops/frontend",
    "build": "npm run build -w @merchops/backend && npm run build -w @merchops/frontend",
    "build:frontend": "npm run build -w @merchops/frontend",
    "start": "npm run start -w @merchops/frontend",
    "lint": "npm run lint -w @merchops/frontend",
    "db:generate": "npm run db:generate -w @merchops/backend",
    "db:push": "npm run db:push -w @merchops/backend",
    "db:seed": "npm run db:seed -w @merchops/backend",
    "db:reset": "npm run db:reset -w @merchops/backend",
    "test:features": "node scripts/test-features.mjs",
    "postinstall": "npm run db:generate -w @merchops/backend"
  }
}
