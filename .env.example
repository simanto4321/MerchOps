# Prisma datasource (SQLite local — file is created under /prisma)
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Vercel / Neon / Supabase), use:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/merchops?sslmode=require"
# and set provider = "postgresql" in prisma/schema.prisma

NEXT_PUBLIC_APP_NAME="MerchOps"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
