# --- Database (SQLite file under /prisma — real persistence) ---
DATABASE_URL="file:./dev.db"

# --- For PostgreSQL (docker compose or hosted) ---
# 1) docker compose up -d
# 2) set provider = "postgresql" in prisma/schema.prisma
# 3) DATABASE_URL="postgresql://merchops:merchops@127.0.0.1:5432/merchops"

NEXT_PUBLIC_APP_NAME="MerchOps"

# Demo login chips + in-desk role switcher (set false in public production)
ALLOW_DEMO_ACCOUNTS="true"
ALLOW_ROLE_SWITCH="true"

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
